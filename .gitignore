/target
# Local config (contains token) — never committed. Also covers backups
# like config.toml.bak that editors and `mv` produce.
config.toml
config.toml.*
# Ignore everything under /data except the workflows symlink pointing at
# the sibling project-zun (or zun-flux-pipeline) workflows directory.
# User prompts live in jobs.db (custom_prompts table); v2 has no
# prompts.toml.
/data/*
!/data/workflows
.claude
