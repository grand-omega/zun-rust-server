#!/usr/bin/env bash
# Blocks `git push` if any commit being pushed ever touched a forbidden path
# (user data, images, logs, real secrets) — checks the full commit range,
# not just the final tree, since a push exposes the whole history.
# See scripts/check-forbidden-paths.sh.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue  # deleting a ref

    if [[ "$remote_sha" == "$zero" ]]; then
        commits=$(git rev-list "$local_sha" --not --remotes)
    else
        commits=$(git rev-list "$remote_sha..$local_sha")
    fi
    [[ -z "$commits" ]] && continue

    files=$(echo "$commits" | git diff-tree --no-commit-id --name-only -r --root --stdin | sort -u)
    [[ -z "$files" ]] && continue

    if ! echo "$files" | ./scripts/check-forbidden-paths.sh; then
        status=1
    fi
done

exit "$status"
