#!/usr/bin/env bash
# Blocks committing user data / secrets (images, logs, jobs.db, real
# config.toml/.env, anything under data/). See scripts/check-forbidden-paths.sh.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

git diff --cached --name-only --diff-filter=ACMR | ./scripts/check-forbidden-paths.sh
